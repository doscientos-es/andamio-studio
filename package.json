{
  "name": "@doscientos-es/andamio-studio",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "format": "oxfmt -c .oxfmtrc.json --write .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "lint": "oxlint src/app src/routes src/features/document-library src/main.tsx src/routeTree.gen.ts vite.config.ts vitest.config.ts oxlint.config.ts",
    "lint:fix": "oxlint --fix --fix-suggestions src/app src/routes src/features/document-library src/main.tsx src/routeTree.gen.ts vite.config.ts vitest.config.ts oxlint.config.ts",
    "structure:check": "doscientos-structure --root src --tanstack-router",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quality": "pnpm format:check && pnpm lint && pnpm structure:check && pnpm typecheck && pnpm test",
    "quality:quick": "pnpm format:check && pnpm lint"
  },
  "dependencies": {
    "@doscientos/ui": "^0.1.42",
    "@tanstack/react-router": "^1.170.18",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@doscientos/configs": "^0.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.15.2"
  },
  "packageManager": "pnpm@9.15.2"
}
