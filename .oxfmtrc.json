{
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/AGENTS.md",
    ".next/**",
    ".turbo/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "src/routeTree.gen.ts",
    "playwright-report/**",
    "storybook-static/**",
    "test-results/**"
  ],
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "clsx"],
    "stylesheet": "./src/styles.css"
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
